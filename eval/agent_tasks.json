{
  "name": "Original synthetic agent task examples",
  "description": "仅为工具路由与任务结构示例。事实任务需要先在隔离库准备 synthetic:alpha/beta；真实录制回放见 agent_demos.json。不是质量基准。",
  "cases": [
    {
      "id": "status-demo",
      "kind": "single_tool",
      "task": "查看文献库的条目数和状态",
      "must_call": [
        "library_status"
      ],
      "expect_keywords": [
        [
          "篇"
        ]
      ]
    },
    {
      "id": "ask-demo",
      "kind": "single_tool",
      "task": "Synthetic Alpha 使用哪个数据集？",
      "must_call": [
        "ask_library"
      ],
      "expect_keywords": [
        [
          "DATA-ALPHA"
        ]
      ]
    },
    {
      "id": "compare-demo",
      "kind": "multi_step",
      "task": "比较 synthetic:alpha 和 synthetic:beta 的研究目标、数据集和指标",
      "must_call": [
        "compare_papers"
      ],
      "expect_keywords": [
        [
          "DATA-ALPHA"
        ],
        [
          "DATA-BETA"
        ]
      ]
    },
    {
      "id": "empty-demo",
      "kind": "boundary",
      "task": "库中是否报告过 Synthetic Alpha 的耗电量？没有证据请说明。",
      "must_call": [
        "ask_library"
      ],
      "forbidden": [
        "add_papers"
      ]
    }
  ]
}
